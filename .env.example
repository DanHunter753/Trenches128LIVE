# copy to .env and edit
DOMAIN=game.example.com
T128_NAME=My Trench 128 server
# off | optional | required  (required: every player needs an account)
T128_ACCOUNTS=optional
# 1 = this server also keeps a server list other servers can join
T128_REGISTRY=1
# list this server on another server list, e.g. https://list.example.com (leave empty to skip)
T128_MASTER=
# AI soldiers per team, human slots per team
T128_FILL=40
T128_SLOTS=128
T128_REGION=EU
# only pages from these origins may connect (comma separated, empty = any). Add your github.io page here if you use one.
T128_ORIGINS=
# vote = players vote between rounds (trenches: Operation or Attrition, or Wake Atoll); random = a new trench map every round;
# rotate = two trench maps then Wake; wake = Wake Atoll only; classic = the original map; or a number = always that map
T128_MAPS=vote
# trench-map mode when there is no vote: ops (Operation), attrition, or mix
T128_MODE=ops
# where https://your-server/download sends players for the Windows launcher (the newest GitHub release)
T128_LAUNCHER_URL=https://github.com/DanHunter753/Trenches128LIVE/releases/latest/download/Trench128-Setup.exe
